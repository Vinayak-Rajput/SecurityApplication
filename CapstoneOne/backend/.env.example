# Copy to .env and replace the local development placeholders.
DB_URL=jdbc:postgresql://localhost:5432/capstone_one
DB_USERNAME=capstone_app
DB_PASSWORD=replace-with-local-database-password
AUDIT_DB_WRITER_USERNAME=capstone_audit_writer
AUDIT_DB_WRITER_PASSWORD=replace-with-a-unique-audit-writer-password
AUDIT_DB_READER_USERNAME=capstone_audit_reader
AUDIT_DB_READER_PASSWORD=replace-with-a-unique-audit-reader-password

# Generate a Base64-encoded random key with: openssl rand -base64 32
JWT_SECRET=replace-with-openssl-rand-base64-32-output
JWT_ACTIVE_KEY_ID=primary
JWT_PREVIOUS_KEY_ID=
JWT_PREVIOUS_SECRET=
JWT_EXPIRATION=5m
JWT_REFRESH_EXPIRATION=16h40m
JWT_REFRESH_MAX_LIFETIME=7d
JWT_ISSUER=secapp
JWT_ACCESS_AUDIENCE=secapp-api
JWT_REFRESH_AUDIENCE=secapp-refresh

FRONTEND_ALLOWED_ORIGINS=http://localhost:3000
AUTH_REFRESH_COOKIE_SECURE=true
AUTH_REFRESH_COOKIE_SAME_SITE=Lax
